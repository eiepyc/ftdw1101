# Copy to .env for Docker Compose or .env.local for local Next.js, then replace every value.
# These are server-only values. Never add a NEXT_PUBLIC_ prefix.
APP_ORIGIN=https://slots.example.com
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret
SESSION_HASH_SECRET=replace-with-at-least-32-random-bytes
DEVICE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
DEVICE_HASH_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
# none for direct local access; use edgeone or vercel only on that platform's direct deployment.
APP_PROXY_MODE=none
PUBLIC_DOMAIN=slots.example.com
