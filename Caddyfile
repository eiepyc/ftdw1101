{
	servers {
		timeouts {
			read_body 15s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 16KB
	}
	@health path /api/health
	header @health Cache-Control "no-store"
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
